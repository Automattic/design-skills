{
  "color": {
    "$type": "color",
    "$description": "Primitive color palette",
    "blue": {
      "50": { "$value": { "colorSpace": "srgb", "components": [0.93, 0.96, 1] } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.89, 0.95, 0.99] } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.79, 0.89, 0.98] } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.63, 0.81, 0.95] } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.42, 0.71, 0.91] } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.13, 0.59, 0.95] } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.12, 0.53, 0.90] } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.10, 0.46, 0.82] } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.08, 0.40, 0.75] } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.05, 0.28, 0.63] } }
    },
    "neutral": {
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
      "50": { "$value": { "colorSpace": "srgb", "components": [0.98, 0.98, 0.98] } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.96, 0.96, 0.96] } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.90, 0.90, 0.90] } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.83, 0.83, 0.83] } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.64, 0.64, 0.64] } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.46, 0.46, 0.46] } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.32, 0.32, 0.32] } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.24, 0.24, 0.24] } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.15, 0.15, 0.15] } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.09, 0.09, 0.09] } },
      "1000": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0] } }
    },
    "red": {
      "500": { "$value": { "colorSpace": "srgb", "components": [0.96, 0.26, 0.21] } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.90, 0.22, 0.21] } }
    },
    "green": {
      "500": { "$value": { "colorSpace": "srgb", "components": [0.30, 0.69, 0.31] } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.26, 0.63, 0.28] } }
    },
    "yellow": {
      "500": { "$value": { "colorSpace": "srgb", "components": [1, 0.76, 0.03] } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.98, 0.66, 0] } }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale based on 4px",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } },
    "24": { "$value": { "value": 96, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Border radius scale",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "md": { "$value": { "value": 4, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } },
    "xl": { "$value": { "value": 12, "unit": "px" } },
    "2xl": { "$value": { "value": 16, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"] },
      "serif": { "$value": ["Georgia", "Cambria", "Times New Roman", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "Consolas", "Monaco", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "base": { "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$value": { "value": 1.125, "unit": "rem" } },
      "xl": { "$value": { "value": 1.25, "unit": "rem" } },
      "2xl": { "$value": { "value": 1.5, "unit": "rem" } },
      "3xl": { "$value": { "value": 1.875, "unit": "rem" } },
      "4xl": { "$value": { "value": 2.25, "unit": "rem" } },
      "5xl": { "$value": { "value": 3, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "none": { "$value": 1 },
      "tight": { "$value": 1.25 },
      "snug": { "$value": 1.375 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.625 },
      "loose": { "$value": 2 }
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "Animation durations",
    "instant": { "$value": { "value": 0, "unit": "ms" } },
    "fast": { "$value": { "value": 100, "unit": "ms" } },
    "normal": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 300, "unit": "ms" } },
    "slower": { "$value": { "value": 500, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Animation timing functions",
    "linear": { "$value": [0, 0, 1, 1] },
    "ease": { "$value": [0.25, 0.1, 0.25, 1] },
    "ease-in": { "$value": [0.42, 0, 1, 1] },
    "ease-out": { "$value": [0, 0, 0.58, 1] },
    "ease-in-out": { "$value": [0.42, 0, 0.58, 1] }
  }
}
